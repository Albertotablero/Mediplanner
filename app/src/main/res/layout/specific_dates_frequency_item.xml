<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <EditText
        android:id="@+id/startDateInput"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="0"
        android:ems="6"
        android:inputType="date" />

    <ImageButton
        android:id="@+id/startDateCalendarDialogB"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/startDateInput"
        android:layout_weight="0"
        app:srcCompat="@drawable/ic_calendar_button" />

    <TextView
        android:id="@+id/removeDateButon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignWithParentIfMissing="true"
        android:layout_alignBaseline="@id/startDateInput"
        android:layout_toEndOf="@id/startDateCalendarDialogB"
        android:background="@android:color/transparent"
        android:minWidth="25dip"
        android:text="X"
        android:textAlignment="center"
        android:textColor="@android:color/holo_red_light"
        android:textSize="20sp" />
</RelativeLayout>