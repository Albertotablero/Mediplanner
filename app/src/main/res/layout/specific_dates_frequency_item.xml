<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <EditText
        android:id="@+id/startDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="0"
        android:ems="6"
        android:inputType="date" />

    <ImageButton
        android:id="@+id/calendarDialogButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/startDate"
        android:layout_weight="0"
        app:srcCompat="@drawable/ic_calendar_button" />

    <TextView
        android:id="@+id/removeDateButon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignWithParentIfMissing="true"
        android:layout_alignBaseline="@id/startDate"
        android:layout_toEndOf="@id/calendarDialogButton"
        android:background="@android:color/transparent"
        android:minWidth="25dip"
        android:text="x"
        android:textColor="@android:color/holo_red_light" />
</RelativeLayout>