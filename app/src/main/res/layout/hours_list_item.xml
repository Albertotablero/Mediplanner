<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:gravity="center"
    android:layout_marginStart="10dp">

    <LinearLayout
        android:id="@+id/hoursLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/pickedHour"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingVertical="5dp"
            android:text="0"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/separator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBaseline="@id/pickedHour"
            android:layout_gravity="center"
            android:paddingVertical="5dp"
            android:text=":"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/pickedMinute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBaseline="@id/pickedHour"
            android:layout_gravity="center"
            android:paddingVertical="5dp"
            android:text="00"
            android:textSize="20sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/removeHourButon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignWithParentIfMissing="true"
        android:layout_alignBaseline="@id/hoursLayout"
        android:layout_alignParentTop="true"
        android:layout_marginHorizontal="5dp"
        android:layout_toEndOf="@id/hoursLayout"
        android:background="@android:color/transparent"
        android:minWidth="25dip"
        android:paddingVertical="5dp"
        android:text="X"
        android:textAlignment="center"
        android:textColor="@android:color/holo_red_light"
        android:textSize="20sp" />
</RelativeLayout>