<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <NumberPicker
        android:id="@+id/pickerHours"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBaseline="@id/pickerHours"
        android:layout_toEndOf="@id/pickerHours"
        android:text=":" />

    <NumberPicker
        android:id="@+id/pickerMinutes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBaseline="@id/pickerHours"
        android:layout_toEndOf="@id/textView2" />

    <TextView
        android:id="@+id/removeHourButon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignWithParentIfMissing="true"
        android:layout_alignBaseline="@id/textView2"
        android:layout_toEndOf="@id/pickerMinutes"
        android:background="@android:color/transparent"
        android:minWidth="25dip"
        android:text="x"
        android:textColor="@android:color/holo_red_light" />
</RelativeLayout>