<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/list_selected_item_bg">

    <TextView
        android:id="@+id/nameTreatmentsTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_margin="5dp"
        android:maxLines="2"
        android:minLines="2"
        android:textColor="@color/list_selected_item_text"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/iconTreatments"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toLeftOf="@id/quantityTextView"
        android:layout_toEndOf="@id/nameTreatmentsTextView"
        android:maxWidth="16dp"
        android:maxHeight="16dp"
        app:srcCompat="@android:drawable/alert_light_frame" />

    <TextView
        android:id="@+id/descriptionTreatments"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/iconTreatments"
        android:layout_alignParentLeft="true"
        android:layout_margin="5dp"
        android:layout_toLeftOf="@id/moreTreatmentsTextView"
        android:textColor="@color/list_selected_item_text" />

    <TextView
        android:id="@+id/moreTreatmentsTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_margin="5dp"
        android:text="@string/more"
        android:textColor="@color/light_purple" />

    <TextView
        android:id="@+id/quantityTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBaseline="@id/quantityMetricTextView"
        android:layout_marginVertical="10dp"
        android:layout_marginLeft="10dp"
        android:layout_marginEnd="0dp"
        android:layout_toStartOf="@id/quantityMetricTextView"
        android:textColor="@color/list_selected_item_text"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/quantityMetricTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_margin="10dp"
        android:textColor="@color/list_selected_item_text"
        android:textSize="20sp" />
</RelativeLayout>