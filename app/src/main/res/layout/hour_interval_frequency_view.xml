<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <EditText
        android:id="@+id/hourIntervalEditText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:ems="3"
        android:inputType="number"
        android:maxEms="3"
        android:maxLines="1" />

    <LinearLayout
        android:id="@+id/hoursLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/hourIntervalEditText"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/startTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="@string/startingHour" />

        <NumberPicker
            android:id="@+id/monthPicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginHorizontal="2dp"
            android:baselineAligned="true" />

        <TextView
            android:id="@+id/separator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBaseline="@id/pickedHour"
            android:layout_gravity="center"
            android:paddingVertical="5dp"
            android:text=":"
            android:textSize="20sp" />

        <NumberPicker
            android:id="@+id/yearPicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="2dp"
            android:layout_toEndOf="@id/separator"
            android:baselineAligned="true" />
    </LinearLayout>

    <com.example.mediplanner.utils.NoScrollListView
        android:id="@+id/hoursInADay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginHorizontal="10dp"
        android:layout_toEndOf="@id/hoursLayout" />
</RelativeLayout>