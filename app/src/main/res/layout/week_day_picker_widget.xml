<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/weekDayButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/light_grey"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/mondayButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="1dp"
            android:layout_marginVertical="2dp"
            android:layout_marginStart="1dp"
            android:layout_weight="1"
            android:background="@drawable/list_selected_item_bg"
            android:clickable="true"
            android:contextClickable="false"
            android:defaultFocusHighlightEnabled="false"
            android:includeFontPadding="false"
            android:padding="10dp"
            android:singleLine="true"
            android:text="@string/monday"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/tuesdayButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignBaseline="@id/mondayButton"
            android:layout_marginHorizontal="1dp"
            android:layout_marginVertical="2dp"
            android:layout_weight="1"
            android:background="@drawable/list_selected_item_bg"
            android:clickable="true"
            android:contextClickable="false"
            android:defaultFocusHighlightEnabled="false"
            android:includeFontPadding="false"
            android:padding="10dp"
            android:singleLine="true"
            android:text="@string/tuesday"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/wednesdayButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignBaseline="@id/tuesdayButton"
            android:layout_marginHorizontal="1dp"
            android:layout_marginVertical="2dp"
            android:layout_weight="1"
            android:background="@drawable/list_selected_item_bg"
            android:clickable="true"
            android:contextClickable="false"
            android:defaultFocusHighlightEnabled="false"
            android:includeFontPadding="false"
            android:padding="10dp"
            android:singleLine="true"
            android:text="@string/wednesday"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/thursdayButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignBaseline="@id/wednesdayButton"
            android:layout_marginHorizontal="1dp"
            android:layout_marginVertical="2dp"
            android:layout_weight="1"
            android:background="@drawable/list_selected_item_bg"
            android:clickable="true"
            android:contextClickable="false"
            android:defaultFocusHighlightEnabled="false"
            android:includeFontPadding="false"
            android:padding="10dp"
            android:singleLine="true"
            android:text="@string/thursday"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/fridayButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignBaseline="@id/thursdayButton"
            android:layout_marginHorizontal="1dp"
            android:layout_marginVertical="2dp"
            android:layout_weight="1"
            android:background="@drawable/list_selected_item_bg"
            android:clickable="true"
            android:contextClickable="false"
            android:defaultFocusHighlightEnabled="false"
            android:includeFontPadding="false"
            android:padding="10dp"
            android:singleLine="true"
            android:text="@string/friday"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/saturdayButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignBaseline="@id/fridayButton"
            android:layout_marginHorizontal="1dp"
            android:layout_marginVertical="2dp"
            android:layout_weight="1"
            android:background="@drawable/list_selected_item_bg"
            android:clickable="true"
            android:contextClickable="false"
            android:defaultFocusHighlightEnabled="false"
            android:includeFontPadding="false"
            android:padding="10dp"
            android:singleLine="true"
            android:text="@string/saturday"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/sundayButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignBaseline="@id/saturdayButton"
            android:layout_marginHorizontal="1dp"
            android:layout_marginVertical="2dp"
            android:layout_marginEnd="1dp"
            android:layout_weight="1"
            android:background="@drawable/list_selected_item_bg"
            android:clickable="true"
            android:contextClickable="false"
            android:defaultFocusHighlightEnabled="false"
            android:includeFontPadding="false"
            android:padding="10dp"
            android:singleLine="true"
            android:text="@string/sunday"
            android:textColor="@color/black" />
    </LinearLayout>

    <com.example.mediplanner.utils.NoScrollListView
        android:id="@+id/hoursListWeekly"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/weekDayButtons"
        android:layout_alignEnd="@id/weekDayButtons" />

</RelativeLayout>